# Copy to deploy/vps.credentials (gitignored) and edit as needed.
#
#   cp deploy/vps.credentials.example deploy/vps.credentials

VPS_HOST=14.225.212.3
VPS_USER=root
VPS_PASSWORD=your-root-password-here

# Remote install path (must match where you unzip / git clone)
VPS_INSTALL_DIR=/root/inspo

# Shown in browser URLs for IP-only deploy (usually same as VPS_HOST)
VPS_PUBLIC_IP=14.225.212.3

# ip     = ports 3000/3001/8000 (no DNS) — same as Oct 2026 session
# prod   = requires SHOP1_DOMAIN, BASELINE_DOMAIN, MEDIA_DOMAIN below + DNS pointed at VPS
DEPLOY_MODE=ip

# Only when DEPLOY_MODE=prod (used by remote setup; run deploy/setup.sh interactively if you prefer)
# SHOP1_DOMAIN=shop1.example.com
# BASELINE_DOMAIN=baseline.example.com
# MEDIA_DOMAIN=media.example.com
# CERT_EMAIL=you@example.com
