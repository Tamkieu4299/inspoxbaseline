# PRODUCTION environment — copy to `.env` on the VPS and fill in real values.
#
#   cp deploy/.env.prod.example .env
#   # edit .env with real domains/secrets, then:
#   docker compose --env-file .env -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# Generate secrets with:  openssl rand -hex 32
#
# The backend refuses to start in production if these are weak/placeholder values.

ENVIRONMENT=production

# Public hostnames (must resolve to your VPS; Caddy provisions HTTPS automatically)
SHOP1_DOMAIN=shop1.example.com
BASELINE_DOMAIN=baseline.example.com
MEDIA_DOMAIN=media.example.com
CERT_EMAIL=you@example.com

# Browser origins that may call the API directly (same-origin storefronts are proxied
# and do NOT need to be listed here — keep this list tight).
CORS_ORIGINS=https://shop1.example.com,https://baseline.example.com

# Host allowlist the backend accepts (also used to trust X-Forwarded-* headers).
TRUSTED_HOSTS=shop1.example.com,baseline.example.com,media.example.com,localhost,127.0.0.1

# --- Secrets (openssl rand -hex 32) ---
# Placeholders below are intentionally too short/weak: the backend refuses to start
# with them, which forces you to replace them.
JWT_SECRET=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
ADMIN_DEFAULT_PASSWORD=change-me
