# Local development environment template.
# Copy to .env and adjust if you want to override docker-compose.yml defaults.
# Every value here has a working dev default baked into docker-compose.yml,
# so .env is optional for local development.
#
#   cp .env.example .env

# Which storefront the "frontend" service serves (shop1 or baseline)
VITE_TENANT_SLUG=shop1

# MinIO root credentials (S3 API + web console). Backend uses the same values.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Browser-facing URL for uploaded media
MINIO_PUBLIC_URL=http://localhost:9000

# Backend secrets — only safe values for local dev
JWT_SECRET=inspo-dev-jwt-secret-change-me-in-development-only
ADMIN_DEFAULT_PASSWORD=admin123

# Browser origins allowed to call the API directly (same-origin proxied apps can ignore)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
TRUSTED_HOSTS=*
